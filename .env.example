# Copy to .env and fill in what you need. Every value is optional:
# with nothing set, Icarus runs locally with the built-in offline coach.

# ── Server ────────────────────────────────────────────────────────────────
PORT=4319
# Loopback by default. To listen on a network interface, set HOST and list the
# public host name(s) the server may answer to; the server refuses to start otherwise.
# HOST=0.0.0.0
# ALLOWED_HOSTS=icarus.example.com
# Behind a trusted reverse proxy, read the client address from X-Forwarded-For.
# TRUST_PROXY=1
# Paid AI requests allowed per client address per 10 minutes.
AI_REQUESTS_PER_10_MIN=40

# ── AI coaches (each turns on when its key or path is set) ────────────────
# Claude through the Anthropic API.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI Responses API.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra

# Claude Code CLI with your existing login (absolute path to the executable).
CLAUDE_CLI_PATH=
# CLAUDE_MODEL=

# Codex CLI with your existing `codex login` (absolute path to the executable).
CODEX_CLI_PATH=
# CODEX_MODEL=

# ── Marketplace ───────────────────────────────────────────────────────────
# Gyms, professionals and packages come from data/demo (fictional, labelled
# demonstration listings) until a live provider is connected. See docs/DEPLOYMENT.md.
# Where enquiries and booking requests are stored (JSON lines, owner-only permissions).
# DATA_DIR=/var/lib/icarus
# Requests are deleted automatically after this many days.
REQUEST_RETENTION_DAYS=90
# Optional HTTPS endpoint that receives each new request as JSON (your CRM,
# booking system or a provider integration). Without it, requests are stored only.
# REQUEST_WEBHOOK_URL=https://hooks.example.com/icarus
# Optional map tiles for the gym map view (HTTPS, {z}/{x}/{y} placeholders).
# Use a provider whose terms allow your traffic, and credit it below.
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© Example map contributors
# Shown in the footer, privacy notice and support page.
# SUPPORT_EMAIL=support@example.com
