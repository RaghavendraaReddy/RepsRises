{
  "name": "icarus",
  "version": "4.0.0",
  "description": "Icarus: discover gyms and memberships, book a trainer and nutritionist together, and train with guided workouts, real exercise demonstrations and an AI coach.",
  "keywords": ["fitness", "gym", "personal-training", "nutrition", "workout", "membership"],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env dist/server/main.js",
    "dev": "npm start",
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test --test-timeout=15000 tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@playwright/test": "1.56.0",
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
